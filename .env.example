# Copy to .env next to docker-compose.yml; `docker compose` reads it from there.

# Required before the port is published beyond 127.0.0.1: without it /api/scan
# and the watchlist write endpoints accept anyone who can reach the port.
# Clients send it in the X-API-Key header; the web UI asks for it on first 401.
PATCHRADAR_API_KEY=

# Optional: raises NVD's rate limit from 5 to 50 requests per 30 seconds.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
